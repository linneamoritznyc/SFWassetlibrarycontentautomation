# SFW Content Studio — every variable from backend spec section 12.
# Copy to .env.local and fill in. Never commit .env.local.

# ---------- shared (web + all workers) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=sfw-media
R2_BUCKET_RAW=sfw-raw

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model ids. Overridable so a model swap needs no code change.
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_LONGFORM=claude-opus-5
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- web (apps/web) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated list of email addresses allowed to sign in.
APP_ALLOWLIST=linnea@soilfoodweb.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/canva/callback
# 32-byte key, base64. Encrypts Canva OAuth tokens at rest.
TOKEN_ENC_KEY=

# Shared secret the inbound-email provider signs question answers with.
INBOUND_EMAIL_SECRET=

# ---------- workers ----------
# Comma-separated job types this worker process claims.
WORKER_TYPES=
WORKER_CONCURRENCY=4

IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

NOTIFY_EMAIL=linnea@soilfoodweb.com
# Transactional email sender (Monday review notice, question routing).
RESEND_API_KEY=

# ---------- database ----------
# Direct Postgres connection, used by the workers and the migration/seed CLI.
# Supabase dashboard: Project Settings, Database, Connection string, URI.
# Use the pooled connection (port 6543) for the workers.
DATABASE_URL=
# Optional. Path to the Supabase CA certificate, so TLS is verified properly.
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=5

# Only for running the tests. A Postgres the test user can create databases on,
# with the vector and pgcrypto extensions available. Tests skip when unset.
TEST_DATABASE_URL=
